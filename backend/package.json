{
  "name": "sync-backend",
  "version": "1.0.0",
  "description": "Backend for Sync School Management System",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "npm run build && node --test tests/schoolDataArchiveService.test.js tests/academicValidation.test.js dist/tests/termLifecycleRules.test.js dist/tests/termBackfillPlanner.test.js dist/tests/termRolloverReadiness.test.js dist/tests/termRolloverAzureBlobBackupStore.test.js dist/tests/studentDuplicateService.test.js",
    "test:term-lifecycle:integration": "npm run build && node --require ./tests/testEnvironment.js --test dist/tests/termLifecycleService.integration.test.js",
    "test:term-backfill:integration": "npm run build && node --require ./tests/testEnvironment.js --test dist/tests/termBackfillDataSource.integration.test.js",
    "test:student-placement:integration": "npm run build && node --require ./tests/testEnvironment.js --test dist/tests/studentPlacement.integration.test.js",
    "test:payment-settlement:integration": "npm run build && node --require ./tests/testEnvironment.js --test dist/tests/paymentSettlement.integration.test.js",
    "test:report-finalization:integration": "npm run build && node --require ./tests/testEnvironment.js --test dist/tests/reportFinalization.integration.test.js",
    "test:term-rollover-preparation:integration": "npm run build && node --require ./tests/testEnvironment.js --test dist/tests/termRolloverPreparation.integration.test.js",
    "test:term-rollover-enrollment:integration": "npm run build && node --require ./tests/testEnvironment.js --test dist/tests/termRolloverEnrollment.integration.test.js",
    "test:term-rollover-readiness:integration": "npm run build && node --require ./tests/testEnvironment.js --test dist/tests/termRolloverReadiness.integration.test.js",
    "finance-settlement:reconcile": "ts-node src/scripts/reconcile-finance-settlement.ts",
    "term-backfill:plan": "ts-node src/scripts/backfill-term-rollover.ts",
    "term-backfill:apply": "ts-node src/scripts/backfill-term-rollover.ts --apply"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@prisma/client": "^5.10.0",
    "@types/nodemailer": "^7.0.4",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "form-data": "^4.0.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.0.379",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.37",
    "@types/pdf-parse": "^1.1.5",
    "@types/web-push": "^3.6.4",
    "nodemon": "^3.1.11"
  }
}
