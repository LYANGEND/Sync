{
  "name": "sync-backend",
  "version": "1.0.0",
  "description": "Backend for Sync School Management System",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "nodemon src/server.ts",
    "worker:communications": "node dist/src/workers/communicationWorker.js",
    "worker:communications:dev": "ts-node src/workers/communicationWorker.ts",
    "worker:payments": "node dist/src/workers/paymentWorker.js",
    "worker:payments:dev": "ts-node src/workers/paymentWorker.ts",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "preflight:tenant-files": "ts-node scripts/migrate-tenant-files.ts",
    "migrate:tenant-files": "ts-node scripts/migrate-tenant-files.ts --apply",
    "preflight:class-uniqueness": "ts-node scripts/check-class-identity-conflicts.ts",
    "validate:queue": "ts-node scripts/validate-queue-runtime.ts",
    "validate:api-rate-limit": "ts-node scripts/validate-api-rate-limit.ts",
    "validate:financial-snapshot-cache": "ts-node scripts/validate-financial-snapshot-cache.ts",
    "validate:financial-aggregations": "ts-node scripts/validate-financial-aggregations.ts",
    "validate:sms-rate-limit": "ts-node scripts/validate-sms-rate-limit.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "jest"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@types/nodemailer": "^7.0.4",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "form-data": "^4.0.0",
    "helmet": "^7.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.0.379",
    "prisma": "^5.22.0",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.37",
    "@types/pdf-parse": "^1.1.5",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.12"
  }
}
